generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  SHADOW
  REGISTERED
}

enum ServiceType {
  STO
  TIRE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OwnerType {
  CLIENT
  COMPANY
}

model User {
  id           String     @id @default(uuid())
  phone        String     @unique
  name         String?
  email        String?    @unique
  status       UserStatus @default(SHADOW)
  passwordHash String?

  vehicles       UserVehicle[]
  bookings       Booking[]
  serviceRecords ServiceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Vehicle {
  id    String  @id @default(uuid())
  plate String?
  vin   String? @unique
  make  String?
  model String?
  year  Int?
  color String?

  owners          UserVehicle[]
  bookings        Booking[]
  serviceRecords  ServiceRecord[]
  catalogListings CatalogListing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicles")
}

model UserVehicle {
  id        String  @id @default(uuid())
  userId    String
  vehicleId String
  isHidden  Boolean @default(false)

  user    User    @relation(fields: [userId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  ownedSince DateTime  @default(now())
  ownedUntil DateTime?

  @@unique([userId, vehicleId])
  @@map("user_vehicles")
}

model Booking {
  id          String        @id @default(uuid())
  userId      String
  vehicleId   String
  serviceType ServiceType
  status      BookingStatus @default(PENDING)
  scheduledAt DateTime?
  notes       String?

  user           User            @relation(fields: [userId], references: [id])
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id])
  serviceRecords ServiceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bookings")
}

model ServiceRecord {
  id              String    @id @default(uuid())
  vehicleId       String
  bookingId       String?
  ownerUserId     String?
  ownerType       OwnerType @default(CLIENT)
  serviceType     String
  description     String
  mileage         Int?
  cost            Decimal?  @db.Decimal(10, 2)
  performedAt     DateTime

  vehicle Vehicle  @relation(fields: [vehicleId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
  owner   User?    @relation(fields: [ownerUserId], references: [id])

  createdAt DateTime @default(now())

  @@map("service_records")
}

model OtpCode {
  id        String    @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_codes")
}

enum CatalogListingType {
  SALE
  WANTED
}

enum CatalogListingStatus {
  AVAILABLE
  RESERVED
  SOLD
  CLOSED
}

enum CatalogInquiryType {
  BUY
  EXCHANGE
  QUESTION
  CALLBACK
  EVALUATE
}

enum CatalogInquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model CatalogListing {
  id             String               @id @default(uuid())
  type           CatalogListingType
  make           String
  model          String
  year           Int
  yearMax        Int?
  mileage        Int?
  mileageMax     Int?
  price          Decimal?             @db.Decimal(12, 2)
  bargainEnabled Boolean              @default(true)
  description    String
  photos         String[]
  status         CatalogListingStatus @default(AVAILABLE)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  inquiries CatalogInquiry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("catalog_listings")
}

model CatalogInquiry {
  id        String               @id @default(uuid())
  type      CatalogInquiryType
  status    CatalogInquiryStatus @default(NEW)
  phone     String
  name      String
  message   String?
  offeredPrice       Decimal? @db.Decimal(12, 2)
  tradeVehicleMake   String?
  tradeVehicleModel  String?
  tradeVehicleYear   Int?
  tradeVehicleMileage Int?
  tradeVehiclePlate  String?

  listingId String?
  listing   CatalogListing? @relation(fields: [listingId], references: [id])

  createdAt DateTime @default(now())

  @@map("catalog_inquiries")
}
